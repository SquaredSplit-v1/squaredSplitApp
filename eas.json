{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      // Env vars (EXPO_PUBLIC_SUPABASE_*, APP_ENV, …) come from the linked
      // "development" EAS environment (eas env:list --environment development).
      "environment": "development"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    // QA / internal testing builds. Distribution: install via link.
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "env": {
        "APP_ENV": "staging"
      },
      "autoIncrement": true
    },
    // Store builds. Run with the auto-submit flag to push the finished
    // artifacts to the stores (npm run build:production does this):
    //   eas build --profile production --platform all --auto-submit
    // iOS lands in TestFlight, Android in the Play internal testing track.
    //
    // APP_ENV is pinned here (not just in the linked EAS environment) because
    // app.config.ts derives the bundle identifier from it during config
    // resolution — a production build that evaluated as "development" shipped
    // with the .dev bundle id once already.
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        // Apple ID used by EAS Submit for App Store Connect access.
        "appleId": "pedapati.basanth@gmail.com",
        "appleTeamId": "GDG397AAU5",
        // Apple ID of the com.squaredsplit.app record in App Store Connect.
        // Pinning this makes submits independent of local APP_ENV — without
        // it, eas submit evaluates app.config.ts in the local shell and can
        // target the wrong (dev) app record.
        "ascAppId": "6801000587"
      },
      "android": {
        // Play Console → Setup → API access → service account JSON key.
        // The service account must be invited to the app with
        // "Release to testing tracks" permission.
        "serviceAccountKeyPath": "./google-services.json",
        // Internal testing track — no review, testers get updates in minutes.
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
