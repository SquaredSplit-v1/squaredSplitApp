{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      // Env vars (EXPO_PUBLIC_SUPABASE_*, APP_ENV, …) come from the linked
      // "development" EAS environment (eas env:list --environment development).
      "environment": "development"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    // QA / internal testing builds. Distribution: install via link.
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "autoIncrement": true
    },
    // Store builds. Run with the auto-submit flag to push the finished
    // artifacts to the stores (npm run build:production does this):
    //   eas build --profile production --platform all --auto-submit
    // iOS lands in TestFlight, Android in the Play internal testing track.
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        // Apple ID used by EAS Submit for App Store Connect access.
        "appleId": "pedapati.basanth@gmail.com",
        // 10-digit Apple ID of the app record in App Store Connect
        // (App Store Connect → App Information → Apple ID).
        // The first interactive `eas submit -p ios --latest` can create the
        // app record automatically — fill this afterwards.
        "ascAppId": "TODO_ASC_APP_ID",
        // 10-character Team ID (Apple Developer Membership page).
        "appleTeamId": "TODO_APPLE_TEAM_ID"
        // The first submit also needs an app-specific password (appleid.apple.com
        // → Sign-In and Security → App-Specific Passwords):
        //   EXPO_APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx eas submit -p ios --latest
        // After the first submit, or with an ASC API key configured, autoSubmit
        // works unattended.
      },
      "android": {
        // Play Console → Setup → API access → service account JSON key.
        // The service account must be invited to the app with
        // "Release to testing tracks" permission.
        "serviceAccountKeyPath": "./google-services.json",
        // Internal testing track — no review, testers get updates in minutes.
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
