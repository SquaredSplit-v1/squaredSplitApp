{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*":            ["./*"],
      "@/components/*": ["./components/*"],
      "@/hooks/*":      ["./hooks/*"],
      "@/lib/*":        ["./lib/*"],
      "@/store/*":      ["./store/*"],
      "@/types/*":      ["./types/*"],
      "@/constants/*":  ["./constants/*"],
      "@/assets/*":     ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "supabase/functions/**"
  ]
}