EXPO_TOKEN=

SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_ID=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Edge Function endpoint for phone OTP, e.g.
# https://<project-ref>.supabase.co/functions/v1/phone-auth
EXPO_PUBLIC_SUPABASE_PHONE_AUTH_URL=
SUPABASE_ACCESS_TOKEN=

APPLE_ID=
ASC_APP_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
# Runtime environment read by lib/env.ts (development | staging | production)
EXPO_PUBLIC_APP_ENV=development
# Build-time profile used by EAS / release scripts (development | staging | production)
APP_ENV=development

EAS_BUILD_PROFILE=

# ── Social login (Google) ────────────────────────────────────────────────
# OAuth 2.0 client IDs from Google Cloud Console → APIs & Services → Credentials.
# See docs/social-login-setup.md for the full walkthrough.
# iOS client (Type: iOS, bundle com.squaredsplit.app) — enables Google on iOS
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android client (Type: Android, package com.squaredsplit.app + SHA-1) — enables Google on Android
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Web client (Type: Web application) — pasted into the Supabase Google provider
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
